<ContentPage
    x:Class="Rummy360.Views.PlayersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="135,*">
        <!-- Green Header -->
        <Border Background="{StaticResource PrimaryGreen}">
            <VerticalStackLayout Padding="24,42,24,18" Spacing="6">
                <Label FontSize="13" Text="Player Management" TextColor="{StaticResource PrimaryGreenPale}"/>
                <Label FontAttributes="Bold" FontSize="28" Text="Players" TextColor="{StaticResource White}"/>
            </VerticalStackLayout>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">
                <!-- Add Player Button -->
                <Border Background="{StaticResource PrimaryGreen}" StrokeShape="RoundRectangle 16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AddPlayerTapped"/>
                    </Border.GestureRecognizers>
                    <Grid Padding="16">
                        <Label HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" Text="+ ADD PLAYER" TextColor="{StaticResource White}"/>
                    </Grid>
                </Border>
                <!-- Dynamic Player List -->
                <CollectionView ItemsSource="{Binding Players}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBackground}" Padding="14" Margin="0,4" Stroke="{StaticResource BorderGray}" StrokeShape="RoundRectangle 18">
                                <Grid ColumnDefinitions="52,*,32,32">
                                    <!-- Avatar -->
                                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{Binding AvatarColor}" StrokeShape="RoundRectangle 21">
                                        <Label HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="14" Text="{Binding Initials}" TextColor="{StaticResource White}"/>
                                    </Border>
                                    <!-- Player Details -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="12,0">
                                        <Label FontAttributes="Bold" FontSize="18" Text="{Binding Name}" TextColor="{StaticResource PrimaryText}"/>
                                        <Label FontSize="13" Text="{Binding GamesPlayed, StringFormat='{}{0} Games Played'}" TextColor="{StaticResource SecondaryText}"/>
                                    </VerticalStackLayout>
                                    <!-- Edit -->
                                    <Label Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource AvatarAmber}" FontSize="18" Text="✏️"/>
                                    <!-- Delete -->
                                    <Label Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" TextColor="{StaticResource DangerAccent}" FontSize="18" Text="🗑"/>
                                </Grid>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource ShadowOverlay20}" Offset="0,3" Opacity="0.20" Radius="10"/>
                                </Border.Shadow>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Summary Card -->
                <Border Background="{StaticResource SuccessBackground}" Padding="18" Stroke="{StaticResource SuccessBorder}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="12">
                        <Label FontAttributes="Bold" FontSize="20" Text="Player Summary" TextColor="{StaticResource PrimaryGreenDark}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total Players" TextColor="{StaticResource PrimaryGreenDark}"/>
                            <Label Grid.Column="1" FontAttributes="Bold" Text="4" TextColor="{StaticResource PrimaryGreenDark}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Games Stored" TextColor="{StaticResource PrimaryGreenDark}"/>
                            <Label Grid.Column="1" FontAttributes="Bold" Text="39" TextColor="{StaticResource PrimaryGreenDark}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>