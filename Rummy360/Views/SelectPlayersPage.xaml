<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rummy360.Views.SelectPlayersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <Grid RowDefinitions="95,*">

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            Background="{StaticResource PrimaryGreen}"
            StrokeThickness="0">

            <VerticalStackLayout Padding="24,34,24,18">

                <Label
                    Text="Create New Game"
                    FontSize="13"
                    TextColor="{StaticResource PrimaryGreenSoftText}"/>

                <Label
                    Text="Select Players"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{StaticResource White}"/>

            </VerticalStackLayout>

        </Border>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20,20,20,30"
                                 Spacing="18">

                <!-- INFO BOX -->
                <Border
                    Background="{StaticResource SuccessBackground}"
                    Stroke="{StaticResource SuccessBorderLight}"
                    StrokeShape="RoundRectangle 14">

                    <HorizontalStackLayout Padding="14"
                                           Spacing="10">

                        <Label Text="✔"
                               FontSize="18"
                               TextColor="{StaticResource AccentGreen}"/>

                        <Label
                            Text="Select between 2 and 6 players."
                            FontSize="13"
                            TextColor="{StaticResource PrimaryGreenDark}"/>

                    </HorizontalStackLayout>

                </Border>

                <!-- PLAYER 1 -->
                <Border
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource AccentGreenBrush}"
                    StrokeShape="RoundRectangle 18">

                    <Grid Padding="16"
                          ColumnDefinitions="40,*,Auto">

                            <Border
                                WidthRequest="28"
                                HeightRequest="28"
                                Background="{StaticResource AccentGreen}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">

                            <Label
                                Text="✓"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                FontAttributes="Bold"
                                TextColor="{StaticResource White}"/>

                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="14,0"
                                             Spacing="2">

                            <Label
                                Text="Bhanu Prakash"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource PrimaryText}"/>

                            <Label
                                Text="12 Games Played"
                                FontSize="12"
                                TextColor="{StaticResource SecondaryText}"/>

                        </VerticalStackLayout>

                    <Label
                                Grid.Column="2"
                            Text="BP"
                            FontAttributes="Bold"
                            TextColor="{StaticResource GoldDarkBrush}" 
                            VerticalOptions="Center"/>

                    </Grid>

                </Border>

                <!-- UNSELECTED PLAYERS (RESOURCE COLORS) -->
                <!-- PLAYER 2 -->
                <Border
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLightBrush}"
                    StrokeShape="RoundRectangle 18">

                    <Grid Padding="16"
                          ColumnDefinitions="40,*,Auto">

                        <Border
                            WidthRequest="28"
                            HeightRequest="28"
                            Background="{StaticResource BorderStrokeLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="14,0"
                                             Spacing="2">

                            <Label
                                Text="Ramesh Kumar"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource PrimaryText}"/>

                            <Label
                                Text="4 Games Played"
                                FontSize="12"
                                TextColor="{StaticResource SecondaryText}"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="RK"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AccentGreen}"
                            VerticalOptions="Center"/>

                    </Grid>

                </Border>

                <!-- PLAYER 3 -->
                <Border
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLightBrush}"
                    StrokeShape="RoundRectangle 18">

                    <Grid Padding="16"
                          ColumnDefinitions="40,*,Auto">

                        <Border
                            WidthRequest="28"
                            HeightRequest="28"
                            Background="{StaticResource BorderStrokeLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="14,0"
                                             Spacing="2">

                            <Label
                                Text="Suresh Kumar"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource PrimaryText}"/>

                            <Label
                                Text="0 Games Played"
                                FontSize="12"
                                TextColor="{StaticResource SecondaryText}"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="SK"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AvatarBlue}"
                            VerticalOptions="Center"/>

                    </Grid>

                </Border>

                <!-- /UNSELECTED PLAYERS (RESOURCE COLORS) -->
                <!-- PLAYER 4 -->
                <Border
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                    <Grid Padding="16"
                          ColumnDefinitions="40,*,Auto">

                        <Border
                            WidthRequest="28"
                            HeightRequest="28"
                            Background="{StaticResource BorderStrokeLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="14,0"
                                             Spacing="2">

                            <Label
                                Text="Kiran Kumar"
                                FontAttributes="Bold"
                                FontSize="15"
                            TextColor="{StaticResource PrimaryText}"/>

                            <Label
                                Text="8 Games Played"
                                FontSize="12"
                                TextColor="{StaticResource SecondaryText}"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="KK"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AvatarOrange}"
                            VerticalOptions="Center"/>

                    </Grid>

                </Border>

                <!-- PLAYER 5 -->
                <Border
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                    <Grid Padding="16"
                          ColumnDefinitions="40,*,Auto">

                        <Border
                            WidthRequest="28"
                            HeightRequest="28"
                            Background="{StaticResource BorderStrokeLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="14,0"
                                             Spacing="2">

                            <Label
                                Text="Sai Krishna"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource PrimaryText}"/>

                            <Label
                                Text="2 Games Played"
                                FontSize="12"
                                TextColor="{StaticResource SecondaryText}"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="SK"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AvatarPurple}"
                            VerticalOptions="Center"/>

                    </Grid>

                </Border>

                <!-- PLAYER 6 -->
                <Border
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                    <Grid Padding="16"
                          ColumnDefinitions="40,*,Auto">

                        <Border
                            WidthRequest="28"
                            HeightRequest="28"
                            Background="{StaticResource BorderStrokeLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="14,0"
                                             Spacing="2">

                            <Label
                                Text="Praveen Kumar"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource PrimaryText}"/>

                            <Label
                                Text="15 Games Played"
                                FontSize="12"
                                TextColor="{StaticResource SecondaryText}"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="PK"
                            FontAttributes="Bold"
                            TextColor="{StaticResource DangerText}"
                            VerticalOptions="Center"/>

                    </Grid>

                </Border>

                <!-- SUMMARY -->
                <Border
                    Margin="0,8,0,0"
                    Background="{StaticResource SuccessBackground}"
                    Stroke="{StaticResource SuccessBorderLight}"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Padding="18"
                                         Spacing="8">

                        <Label
                            Text="Selected Players"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryGreenDark}"/>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Players Selected"
                                FontSize="13"/>

                            <Label
                                Grid.Column="1"
                                Text="1 / 6"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryGreenDark}"/>

                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Minimum Required"
                                FontSize="13"/>

                            <Label
                                Grid.Column="1"
                                Text="2 Players"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryGreenDark}"/>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- CONTINUE BUTTON -->
                <Border
                    Background="{StaticResource BorderGray}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Continue_Tapped"/>
                    </Border.GestureRecognizers>
                    
                    <Grid HeightRequest="56">

                        <Label
                            Text="CONTINUE →"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="{StaticResource MutedGray}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>