<ContentPage
    x:Class="Rummy360.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <Grid RowDefinitions="120,Auto,Auto,*" Padding="0">
        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGreen}" StrokeThickness="0">
            <VerticalStackLayout Padding="24,45,24,20" Spacing="4">
                <Label Text="👋 Welcome" FontSize="13" TextColor="{StaticResource PrimaryGreenTint}"/>
                <Label Text="Rummy360" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource White}"/>
            </VerticalStackLayout>
        </Border>
        <!-- LAST GAME CARD -->
        <Border Grid.Row="1" Margin="20,-20,20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Padding="18" Spacing="6">
                <Label Text="LAST GAME" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                <Label Text="No Active Game" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreen}"/>
                <Label Text="Start a new game to begin." FontSize="12" TextColor="{StaticResource SecondaryText}"/>
            </VerticalStackLayout>
        </Border>
        <!-- NEW GAME BUTTON -->
        <Border Grid.Row="2" Margin="20,20,20,0" Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 16">            
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="NewGame_Tapped"/>
            </Border.GestureRecognizers>            
            <Grid HeightRequest="56">
                <Label Text="+ NEW GAME" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource White}"/>
            </Grid>
        </Border>
        <!-- MENU GRID -->
        <Grid Grid.Row="3" Margin="20,20" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
            <!-- PLAYERS CARD -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="PlayersCard_Tapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Padding="18" Spacing="8">
                    <Label Text="👥" FontSize="26"/>
                    <Label Text="Players" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}"/>
                    <Label Text="Manage players" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                </VerticalStackLayout>
            </Border>
            <!-- HISTORY -->
            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="8">
                    <Label Text="🕘" FontSize="26"/>
                    <Label Text="History" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}"/>
                    <Label Text="Past games" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                </VerticalStackLayout>
            </Border>
            <!-- SETTINGS -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Settings_Tapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Padding="18" Spacing="8">
                    <Label Text="⚙️" FontSize="26"/>
                    <Label Text="Settings" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}"/>
                    <Label Text="Game preferences" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                </VerticalStackLayout>
            </Border>
            <!-- STATISTICS -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Statistics_Tapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Padding="18" Spacing="8">
                    <Label Text="🏆" FontSize="26"/>
                    <Label Text="Statistics" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}"/>
                    <Label Text="Wins and games" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>