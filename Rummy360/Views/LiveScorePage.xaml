<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rummy360.Views.LiveScorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <ScrollView>

        <VerticalStackLayout Spacing="18">

            <!-- HEADER -->
            <Border Background="{StaticResource PrimaryGreen}" StrokeThickness="0">

                <VerticalStackLayout Padding="24,34,24,24">

                    <Label Text="Live Game"
                           FontSize="13"
                           TextColor="{StaticResource PrimaryGreenSoftText}"/>

                    <Label Text="Round 1 / Game 101"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"/>

                </VerticalStackLayout>

            </Border>

            <!-- GAME INFO CARD -->
            <Border Margin="20,0"
                    Background="{StaticResource SuccessBackground}"
                    Stroke="{StaticResource SuccessBorderLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="8">

                    <Label Text="👑 Dealer : Bhanu Prakash"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                    <Label Text="Drop Amount : 40 Points"
                           FontSize="13"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                </VerticalStackLayout>

            </Border>

            <!-- CURRENT ROUND SCORE CARD -->
            <Border Margin="20,0"
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="14">

                    <Label Text="CURRENT ROUND SCORES"
                           FontSize="12"
                           TextColor="{StaticResource SecondaryText}"/>

                    <!-- Bhanu -->
                    <Grid ColumnDefinitions="*,60">
                        <Label Text="👑 Bhanu Prakash"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryGreen}"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource PageBackground}"
                                Stroke="{StaticResource BorderStrokeLight}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,6">

                            <Label Text="25"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"/>

                        </Border>
                    </Grid>

                    <!-- Ramesh -->
                    <Grid ColumnDefinitions="*,60">
                        <Label Text="Ramesh Kumar"
                               TextColor="{StaticResource AvatarBlue}"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource PageBackground}"
                                Stroke="{StaticResource BorderStrokeLight}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,6">

                            <Label Text="10"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"/>

                        </Border>
                    </Grid>

                    <!-- Suresh -->
                    <Grid ColumnDefinitions="*,60">
                        <Label Text="Suresh Kumar"
                               TextColor="{StaticResource AvatarOrange}"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource PageBackground}"
                                Stroke="{StaticResource BorderStrokeLight}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,6">

                            <Label Text="40"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"/>

                        </Border>
                    </Grid>

                    <!-- Kiran -->
                    <Grid ColumnDefinitions="*,60">
                        <Label Text="Kiran Kumar"
                               TextColor="{StaticResource AccentGreen}"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource PageBackground}"
                                Stroke="{StaticResource BorderStrokeLight}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,6">

                            <Label Text="5"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"/>

                        </Border>
                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- GRAND TOTAL -->
            <Border Margin="20,0"
                Background="{StaticResource GoldBackgroundAlt}"
                Stroke="{StaticResource WarningBorder}"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="12">

                    <Label Text="GRAND TOTAL"
               FontSize="13"
               FontAttributes="Bold"
               TextColor="{StaticResource WarningText}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="👑 Bhanu Prakash"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreen}"/>
                        <Label Grid.Column="1"
                   Text="25"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreen}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Ramesh Kumar"
                   TextColor="{StaticResource AvatarBlue}"/>
                        <Label Grid.Column="1"
                   Text="10"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AvatarBlue}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Suresh Kumar"
                   TextColor="{StaticResource AvatarOrange}"/>
                        <Label Grid.Column="1"
                   Text="40"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AvatarOrange}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Kiran Kumar"
                   TextColor="{StaticResource AccentGreen}"/>
                        <Label Grid.Column="1"
                   Text="5"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AccentGreen}"/>
                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- GAME PROGRESS -->
            <Border Margin="20,0"
                Background="{StaticResource SuccessBackground}"
                Stroke="{StaticResource SuccessBorderLight}"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="10">

                    <Label Text="GAME PROGRESS"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryGreenDark}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Target Score"/>
                        <Label Grid.Column="1"
                   Text="101"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreenDark}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Drop Amount"/>
                        <Label Grid.Column="1"
                   Text="40 Points"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreenDark}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Current Round"/>
                        <Label Grid.Column="1"
                   Text="1"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreenDark}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Players Remaining"/>
                        <Label Grid.Column="1"
                   Text="4"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreenDark}"/>
                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- ELIMINATION WATCH -->
            <Border Margin="20,0"
                Background="{StaticResource DangerBackground}"
                Stroke="{StaticResource DangerLight}"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="10">

                    <Label Text="ELIMINATION WATCH"
               FontSize="13"
               FontAttributes="Bold"
               TextColor="{StaticResource DangerText}"/>

                    <Label Text="Suresh Kumar is closest to elimination."
               FontSize="13"
               TextColor="{StaticResource DangerText}"/>

                    <!-- Progress -->
                    <Grid HeightRequest="10">

                        <Border Background="{StaticResource DangerLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 5"/>

                        <Border Background="{StaticResource DangerAccent}"
                    WidthRequest="120"
                    StrokeThickness="0"
                    HorizontalOptions="Start"
                    StrokeShape="RoundRectangle 5"/>

                    </Grid>

                    <Label Text="40 / 101 Points"
               FontAttributes="Bold"
               TextColor="{StaticResource DangerText}"/>

                </VerticalStackLayout>

            </Border>

            <!-- ADD ROUND BUTTON -->
            <Border Margin="20,0"
                Background="{StaticResource PrimaryGreen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
                
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AddRound_Tapped"/>
                </Border.GestureRecognizers>
                
                <Grid HeightRequest="58">

                    <Label Text="➕ ADD ROUND SCORE"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"/>

                </Grid>

            </Border>

            <!-- ROUND HISTORY -->
            <Border    Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="12">
                    <Label Text="ROUND HISTORY" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                    <!-- Round 1 -->
                    <Border Background="{StaticResource PageBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Padding="14" Spacing="2">
                            <Label Text="Round 1" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreen}"/>
                            <Label Text="BP 25 • RK 10 • SK 40 • KK 5" FontSize="12" TextColor="{StaticResource SecondaryText}"/>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Round 2 -->
                    <Border Background="{StaticResource PageBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Padding="14" Spacing="2">
                            <Label Text="Round 2" FontAttributes="Bold" TextColor="{StaticResource AvatarBlue}"/>
                            <Label Text="BP 5 • RK 15 • SK 0 • KK 10" FontSize="12" TextColor="{StaticResource SecondaryText}"/>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Round 3 -->
                    <Border Background="{StaticResource PageBackgroundAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Padding="14" Spacing="2">
                            <Label Text="Round 3" FontAttributes="Bold" TextColor="{StaticResource AvatarOrange}"/>
                            <Label Text="BP 20 • RK 30 • SK 10 • KK 5" FontSize="12" TextColor="{StaticResource SecondaryText}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- GAME STATUS -->
            <Border Margin="20,0" Background="{StaticResource SuccessBackground}" Stroke="{StaticResource SuccessBorderLight}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="10">
                    <Label Text="GAME STATUS" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreenDark}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Active Players"/>
                        <Label Grid.Column="1" Text="4" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreenDark}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Dealer Next Round"/>
                        <Label Grid.Column="1" Text="Ramesh Kumar" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreenDark}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Upcoming Round"/>
                        <Label Grid.Column="1" Text="2" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreenDark}"/>
                    </Grid>
                </VerticalStackLayout>

            </Border>

            <!-- FINISH GAME -->
            <Border    Margin="20,0"    Background="{StaticResource PageBackground}"    Stroke="{StaticResource BorderStrokeLight}"    StrokeShape="RoundRectangle 16">
                <Grid HeightRequest="54">
                    <Label Text="🏁 FINISH GAME" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource MutedGray}"/>
                </Grid>
            </Border>

            <!-- FOOTER -->
            <Label Margin="0,8,0,24" Text="Version 1.0 • Offline" FontSize="11" HorizontalOptions="Center" TextColor="{StaticResource Gray400}"/>
        
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>