<?xml version="1.0" encoding="utf-8" ?>

<base:BasePage x:Class="Rummy360.Views.SplashPage" 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:base="clr-namespace:Rummy360.Views.Base"
             Shell.NavBarIsVisible="False" 
             BackgroundColor="{StaticResource PrimaryGreen}">
    <Grid Padding="24,40">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            <!-- Crown -->
            <Image x:Name="CrownImage" Source="crown.svg" WidthRequest="102" HorizontalOptions="Center" Opacity="0" TranslationY="30" Scale="1.5" />
            <!-- Logo + Cards -->
            <Grid WidthRequest="250" HeightRequest="215" Margin="0,-12,0,0">
                <!-- Ace of Spades -->
                <Image x:Name="SpadeCard" Source="card_spade.svg" WidthRequest="92" Rotation="-18" TranslationX="-56" TranslationY="18" Opacity="0" Scale="0.8"/>
                <!-- Two of Hearts -->
                <Image x:Name="HeartCard" Source="card_heart.svg" WidthRequest="92" Rotation="-6" TranslationX="-18" TranslationY="6" Opacity="0" Scale="0.8"/>
                <!-- Three of Diamonds -->
                <Image x:Name="DiamondCard" Source="card_diamond.svg" WidthRequest="92" Rotation="6" TranslationX="18" TranslationY="6" Opacity="0" Scale="0.8"/>
                <!-- Four of Clubs -->
                <Image x:Name="ClubCard" Source="card_club.svg" WidthRequest="92" Rotation="18" TranslationX="56" TranslationY="18" Opacity="0" Scale="0.8"/>
                <!-- Gold Logo Ring -->
                <Image x:Name="LogoRing" Source="logo_ring.svg" WidthRequest="148" HorizontalOptions="Center" VerticalOptions="End" TranslationY="28" Scale="0.5" Opacity="0"/>
            </Grid>
            <!-- Text -->
            <Image x:Name="LogoText" Source="logo_text.svg" WidthRequest="280" Opacity="0" TranslationY="10"/>
            <!-- Loading -->
            <ActivityIndicator x:Name="Loader" Color="{StaticResource GoldAccent}" IsRunning="True"/>
            <Label Text="Shuffling Cards..." FontSize="13" HorizontalOptions="Center" TextColor="{StaticResource PrimaryGreenTint}"/>
        </VerticalStackLayout>
        <Label Text="Version 1.0 • Offline First" HorizontalOptions="Center" VerticalOptions="End" FontSize="12" TextColor="{StaticResource PrimaryGreenSoftText}"/>
    </Grid>
</base:BasePage>