<ContentPage
    x:Class="Rummy360.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PrimaryGreen}">

    <Grid Padding="30">

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="20">

            <!-- Logo Circle -->
    <Border
    WidthRequest="110"
    HeightRequest="110"
    HorizontalOptions="Center"
    BackgroundColor="Transparent"
    Stroke="{StaticResource GoldDark}"
    StrokeThickness="3"
    StrokeShape="RoundRectangle 55">

                <Grid>

                    <Label
                        Text="🂡"
                        FontSize="18"
                        TextColor="{StaticResource GoldDark}"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="10,6,0,0"/>

                    <Label
                        Text="R"
                        FontSize="40"
                        FontAttributes="Bold"
                        TextColor="{StaticResource GoldDark}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                    <Label
                        Text="🂱"
                        FontSize="18"
                        TextColor="{StaticResource GoldDark}"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,6,10,0"/>

                </Grid>

            </Border>

            <!-- App Name -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="0">

                <Label
                    Text="RUMMY"
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="{StaticResource White}"/>

                <Label
                    Text="360"
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="{StaticResource GoldDark}"/>

            </HorizontalStackLayout>

            <!-- Subtitle -->
            <Label
                Text="OFFLINE SCORE TRACKER"
                FontSize="14"
                FontAttributes="Bold"
                CharacterSpacing="2"
                TextColor="{StaticResource GoldPale}"
                HorizontalTextAlignment="Center"/>

            <!-- Loading Text -->
            <Label
                Text="Loading game engine..."
                FontSize="12"
                TextColor="{StaticResource PrimaryGreenSoftText}"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,0"/>

            <!-- Progress Bar -->
            <Border
                BackgroundColor="{StaticResource ProgressBackground}"
                StrokeThickness="0"
                HeightRequest="8"
                WidthRequest="280"
                StrokeShape="RoundRectangle 4">

                <Grid>

                    <Border
                        BackgroundColor="{StaticResource GoldDark}"
                        HorizontalOptions="Start"
                        WidthRequest="170"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 4"/>

                </Grid>

            </Border>

        </VerticalStackLayout>

        <!-- Footer -->
        <VerticalStackLayout
            VerticalOptions="End"
            HorizontalOptions="Center"
            Spacing="2">

            <Label
                Text="Version 1.0 • Offline"
                FontSize="11"
                TextColor="{StaticResource GoldPale}"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Made with ❤️ in India"
                FontSize="11"
                TextColor="{StaticResource GoldMuted}"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>