<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Rummy360.Views.RoundCompletedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <ScrollView>
        <VerticalStackLayout Spacing="18">
            <!-- Green Header -->
            <Border Background="{StaticResource PrimaryGreen}" StrokeThickness="0">
                <VerticalStackLayout Padding="24,34,24,24">
                    <Label FontSize="13" Text="Round Completed" TextColor="{StaticResource PrimaryGreenSoftText}" />
                    <Label FontAttributes="Bold" FontSize="26" Text="Round 2 Finished 🎉" TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Border>
            <!-- Winner Card -->
            <Border Margin="20,0" Background="{StaticResource WinnerBackground}" Stroke="{StaticResource GoldAccent}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="6">
                    <Label FontAttributes="Bold" FontSize="13" Text="ROUND WINNER" TextColor="{StaticResource ChampionText}" />
                    <Label FontAttributes="Bold" FontSize="22" Text="🏆 Kiran Kumar" TextColor="{StaticResource ChampionText}" />
                    <Label FontSize="13" Text="Scored only 5 points this round." TextColor="{StaticResource ChampionSubText}" />
                </VerticalStackLayout>
            </Border>
            <!-- Dealer Rotation -->
            <Border Margin="20,0" Background="{StaticResource SuccessBackground}" Stroke="{StaticResource SuccessBorderLight}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="6">
                    <Label FontAttributes="Bold" FontSize="13" Text="DEALER ROTATED" TextColor="{StaticResource PrimaryGreenDark}" />
                    <Label FontAttributes="Bold" FontSize="20" Text="👑 Ramesh Kumar" TextColor="{StaticResource PrimaryGreenDark}" />
                    <Label FontSize="13" Text="Dealer moved clockwise." TextColor="{StaticResource PrimaryGreenDark}" />
                </VerticalStackLayout>
            </Border>
            <!-- Updated Totals -->
            <Border Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="12">
                    <Label FontAttributes="Bold" FontSize="13" Text="UPDATED GRAND TOTAL" TextColor="{StaticResource SecondaryText}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="👑 Bhanu Prakash" TextColor="{StaticResource PrimaryGreen}" />
                        <Label Grid.Column="1" FontAttributes="Bold" Text="30" TextColor="{StaticResource PrimaryGreen}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Ramesh Kumar" TextColor="{StaticResource AvatarBlue}" />
                        <Label Grid.Column="1" FontAttributes="Bold" Text="25" TextColor="{StaticResource AvatarBlue}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Suresh Kumar" TextColor="{StaticResource AvatarOrange}" />
                        <Label Grid.Column="1" FontAttributes="Bold" Text="40" TextColor="{StaticResource AvatarOrange}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Kiran Kumar" TextColor="{StaticResource AccentGreen}" />
                        <Label Grid.Column="1" FontAttributes="Bold" Text="10" TextColor="{StaticResource AccentGreen}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Continue Button -->
            <Border Margin="20,0" Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                <Grid HeightRequest="56">
                    <Label FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" Text="CONTINUE TO ROUND 3 →" TextColor="{StaticResource White}" VerticalOptions="Center" />
                </Grid>
            </Border>
            <!-- View History -->
            <Border Margin="20,0,20,24" Background="{StaticResource PageBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="History_Tapped"/>
                </Border.GestureRecognizers>
                <Grid HeightRequest="48">
                    <Label HorizontalOptions="Center" Text="VIEW ROUND HISTORY" TextColor="{StaticResource MutedGray}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>