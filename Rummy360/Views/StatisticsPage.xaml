<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Rummy360.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <ScrollView>
        <VerticalStackLayout Spacing="18">
            <Border Background="{StaticResource PrimaryGreen}">
                <VerticalStackLayout Padding="24,34,24,24">
                    <Label Text="Statistics" FontSize="13" TextColor="{StaticResource PrimaryGreenSoftText}"/>
                    <Label Text="Player Leaderboard" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource White}"/>
                </VerticalStackLayout>
            </Border>
            <!-- Champion Card -->
            <Border Margin="20,0" Background="{StaticResource WinnerBackground}" Stroke="{StaticResource GoldAccent}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="6">
                    <Label Text="CURRENT CHAMPION" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ChampionText}"/>
                    <Label Text="🏆 Bhanu Prakash" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource ChampionText}"/>
                    <Label Text="Win Rate : 72%" FontSize="13" TextColor="{StaticResource ChampionSubText}"/>
                </VerticalStackLayout>
            </Border>
            <Grid Margin="20,0" ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Games -->
                <Border Grid.Column="0" Background="{StaticResource SuccessBackground}" Stroke="{StaticResource SuccessBorderLight}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Padding="16">
                        <Label Text="TOTAL GAMES" FontSize="11" TextColor="{StaticResource AccentGreen}"/>
                        <Label Text="28" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource AccentGreen}"/>
                    </VerticalStackLayout>
                </Border>
                <!-- Rounds -->
                <Border Grid.Column="1" Background="{StaticResource InfoBackgroundLight}" Stroke="{StaticResource InfoBorderLight}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Padding="16">
                        <Label
                            Text="TOTAL ROUNDS"
                            FontSize="11"
                            TextColor="{StaticResource AvatarBlue}"/>
                        <Label
                            Text="143"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AvatarBlue}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Border Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="14">
                    <Label Text="TOP PLAYERS" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🥇 Bhanu Prakash" TextColor="{StaticResource AvatarAmber}"/>
                        <Label Grid.Column="1" Text="12 Wins" FontAttributes="Bold" TextColor="{StaticResource AvatarAmber}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🥈 Ramesh Kumar" TextColor="{StaticResource AvatarBlue}"/>
                        <Label Grid.Column="1" Text="8 Wins" FontAttributes="Bold" TextColor="{StaticResource AvatarBlue}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🥉 Suresh Kumar" TextColor="{StaticResource AvatarOrange}"/>
                        <Label Grid.Column="1" Text="5 Wins" FontAttributes="Bold" TextColor="{StaticResource AvatarOrange}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="4️⃣ Kiran Kumar" TextColor="{StaticResource AccentGreen}"/>
                        <Label Grid.Column="1" Text="3 Wins" FontAttributes="Bold" TextColor="{StaticResource AccentGreen}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
                <Border Margin="20,0" Background="{StaticResource SuccessBackground}" Stroke="{StaticResource SuccessBorderLight}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="10">
                    <Label Text="PLAYER INSIGHTS" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreenDark}"/>
                    <Label Text="🔥 Longest Winning Streak : 5 Games" TextColor="{StaticResource PrimaryGreenDark}"/>
                    <Label Text="🎯 Lowest Average Score : 18.2" TextColor="{StaticResource PrimaryGreenDark}"/>
                    <Label Text="👑 Most Dealer Turns : Ramesh Kumar" TextColor="{StaticResource PrimaryGreenDark}"/>
                </VerticalStackLayout>
            </Border>
            <Border Margin="20,0,20,24" Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                <Grid HeightRequest="56">
                    <Label Text="← BACK TO HOME" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>