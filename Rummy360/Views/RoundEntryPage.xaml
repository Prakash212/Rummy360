<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rummy360.Views.RoundEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F7FA">

    <ScrollView>

        <VerticalStackLayout Spacing="18">

            <!-- Green Header -->
            <Border Background="#0F7A3D" StrokeThickness="0">

                <VerticalStackLayout Padding="24,34,24,24">

                    <Label Text="Round Entry"
                           FontSize="13"
                           TextColor="#CFE8DA"/>

                    <Label Text="Enter Round 2 Scores"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"/>

                </VerticalStackLayout>

            </Border>

            <!-- Dealer Card -->
            <Border Margin="20,0"
                    Background="#ECFDF5"
                    Stroke="#BBF7D0"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18">

                    <Label Text="👑 Dealer : Ramesh Kumar"
                           FontAttributes="Bold"
                           TextColor="#166534"/>

                    <Label Text="Round 2 • Game 101"
                           FontSize="13"
                           TextColor="#166534"/>

                </VerticalStackLayout>

            </Border>

            <!-- Player Rows -->
            <!-- Repeat one Border for each player -->
            <!-- Bhanu -->
            <Border Margin="20,0" Background="White" Stroke="#E5E7EB" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="#0F7A3D" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="BP" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="👑 Bhanu Prakash" FontAttributes="Bold" TextColor="#0F7A3D"/>
                        <Label Text="Current Total : 25" FontSize="11" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="#ECFDF5" Stroke="#16A34A" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#0F7A3D"/>
                    </Border>                    
                </Grid>
            </Border>
            <Border Margin="20,0" Background="White" Stroke="#E5E7EB" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="#2563EB" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="RK" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Ramesh Kumar" FontAttributes="Bold" TextColor="#2563EB"/>
                        <Label Text="Current Total : 10" FontSize="11" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="#EFF6FF" Stroke="#2563EB" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#2563EB"/>
                    </Border>
                </Grid>
            </Border>
            <Border Margin="20,0" Background="White" Stroke="#E5E7EB" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="#EA580C" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="SK" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Suresh Kumar" FontAttributes="Bold" TextColor="#EA580C"/>
                        <Label Text="Current Total : 40" FontSize="11" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="#FFF7ED" Stroke="#EA580C" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#EA580C"/>
                    </Border>
                </Grid>
            </Border>
            <Border Margin="20,0" Background="White" Stroke="#E5E7EB" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="#9333EA" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="KK" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Kiran Kumar" FontAttributes="Bold" TextColor="#9333EA"/>
                        <Label Text="Current Total : 5" FontSize="11" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="#FAF5FF" Stroke="#9333EA" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#9333EA"/>
                    </Border>
                </Grid>
            </Border>
            <!--<Border Margin="20,0" Background="White" Stroke="#E5E7EB" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="#0D9488" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="BR" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Rajesh Kumar" FontAttributes="Bold" TextColor="#0D9488"/>
                        <Label Text="Current Total : 50" FontSize="11" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="#F0FDFA" Stroke="#0D9488" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#0D9488"/>
                    </Border>
                </Grid>
            </Border>-->

            <Border Margin="20,0" Background="#FEFCE8" Stroke="#FACC15" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="10">
                    <Label Text="LIVE ROUND SUMMARY" FontAttributes="Bold" FontSize="13" TextColor="#A16207"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Round Total"/>
                        <Label Grid.Column="1" Text="0 Points" FontAttributes="Bold" TextColor="#A16207"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Highest Score"/>
                        <Label Grid.Column="1" Text="--" FontAttributes="Bold" TextColor="#A16207"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Margin="20,0,20,30" Spacing="12">
                <!-- Save -->
                <Border Background="#0F7A3D" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SaveRound_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid HeightRequest="56">
                        <Label Text="SAVE ROUND →" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                    </Grid>
                </Border>
                <!-- Two Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Background="#F3F4F6" Stroke="#E5E7EB" StrokeShape="RoundRectangle 14">
                        <Grid HeightRequest="48">
                            <Label Text="RESET" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="#4B5563"/> 
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#F3F4F6" Stroke="#E5E7EB" StrokeShape="RoundRectangle 14">
                        <Grid HeightRequest="48">
                            <Label Text="CANCEL" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="#4B5563"/>
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
        
    </ScrollView>
</ContentPage>
