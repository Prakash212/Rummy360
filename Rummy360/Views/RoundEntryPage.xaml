<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rummy360.Views.RoundEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <ScrollView>

        <VerticalStackLayout Spacing="18">

            <!-- Green Header -->
            <Border Background="{StaticResource PrimaryGreen}" StrokeThickness="0">

                <VerticalStackLayout Padding="24,34,24,24">

                    <Label Text="Round Entry"
                           FontSize="13"
                           TextColor="{StaticResource PrimaryGreenSoftText}"/>

                    <Label Text="Enter Round 2 Scores"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"/>

                </VerticalStackLayout>

            </Border>

            <!-- Dealer Card -->
            <Border Margin="20,0"
                    Background="{StaticResource SuccessBackground}"
                    Stroke="{StaticResource SuccessBorderLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18">

                    <Label Text="👑 Dealer : Ramesh Kumar"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                    <Label Text="Round 2 • Game 101"
                           FontSize="13"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                </VerticalStackLayout>

            </Border>

            <!-- Player Rows -->
            <!-- Repeat one Border for each player -->
            <!-- Bhanu -->
            <Border Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="{StaticResource PrimaryGreen}" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="BP" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="👑 Bhanu Prakash" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreen}"/>
                        <Label Text="Current Total : 25" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="{StaticResource SuccessBackground}" Stroke="{StaticResource AccentGreen}" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource PrimaryGreen}"/>
                    </Border>                    
                </Grid>
            </Border>
            <Border Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="{StaticResource AvatarBlue}" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="RK" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Ramesh Kumar" FontAttributes="Bold" TextColor="{StaticResource AvatarBlue}"/>
                        <Label Text="Current Total : 10" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="{StaticResource AvatarBluePale}" Stroke="{StaticResource AvatarBlue}" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource AvatarBlue}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="{StaticResource AvatarOrange}" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="SK" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Suresh Kumar" FontAttributes="Bold" TextColor="{StaticResource AvatarOrange}"/>
                        <Label Text="Current Total : 40" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="{StaticResource AvatarOrangePale}" Stroke="{StaticResource AvatarOrange}" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource AvatarOrange}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="{StaticResource AvatarPurple}" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="KK" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Kiran Kumar" FontAttributes="Bold" TextColor="{StaticResource AvatarPurple}"/>
                        <Label Text="Current Total : 5" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="{StaticResource AvatarPurplePale}" Stroke="{StaticResource AvatarPurple}" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource AvatarPurple}"/>
                    </Border>
                </Grid>
            </Border>
            <!--<Border Margin="20,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 18">
                <Grid Padding="14" ColumnDefinitions="52,*,70" ColumnSpacing="12">
                    <Border Background="{StaticResource AvatarTeal}" HeightRequest="42" WidthRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="BR" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Rajesh Kumar" FontAttributes="Bold" TextColor="{StaticResource AvatarTeal}"/>
                        <Label Text="Current Total : 50" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="{StaticResource AvatarTealPale}" Stroke="{StaticResource AvatarTeal}" StrokeShape="RoundRectangle 10">
                        <Label Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource AvatarTeal}"/>
                    </Border>
                </Grid>
            </Border>-->

            <Border Margin="20,0" Background="{StaticResource SummaryBackground}" Stroke="{StaticResource SummaryBorder}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Padding="18" Spacing="10">
                    <Label Text="LIVE ROUND SUMMARY" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource SummaryText}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Round Total"/>
                        <Label Grid.Column="1" Text="0 Points" FontAttributes="Bold" TextColor="{StaticResource SummaryText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Highest Score"/>
                        <Label Grid.Column="1" Text="--" FontAttributes="Bold" TextColor="{StaticResource SummaryText}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Margin="20,0,20,30" Spacing="12">
                <!-- Save -->
                <Border Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SaveRound_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid HeightRequest="56">
                        <Label Text="SAVE ROUND →" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource White}"/>
                    </Grid>
                </Border>
                <!-- Two Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Background="{StaticResource PageBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 14">
                        <Grid HeightRequest="48">
                            <Label Text="RESET" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/> 
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PageBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 14">
                        <Grid HeightRequest="48">
                            <Label Text="CANCEL" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}"/>
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
        
    </ScrollView>
</ContentPage>
