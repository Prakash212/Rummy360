<?xml version="1.0" encoding="utf-8" ?>

<base:BasePage
    x:Class="Rummy360.Views.AddPlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Rummy360.Views.Base"
    xmlns:components="clr-namespace:Rummy360.Components"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <Grid>
        <!-- Watermark -->
        <Image Source="watermark_pattern1.svg" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" ZIndex="0"/>
        <!-- Main Layout -->
        <Grid RowDefinitions="150,Auto,Auto,*" ZIndex="1">
            <!-- Header -->
            <components:PageHeaderView Grid.Row="0" Subtitle="PLAYER MANAGEMENT" Title="Add Player" Description="Create a new player for your Rummy360 family"/>
            <!-- Player Card -->
            <Border Grid.Row="1" Margin="10,18,10,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowOverlay20Brush}" Opacity="0.12" Radius="8" Offset="0,2"/>
                </Border.Shadow>
                <VerticalStackLayout Padding="14">
                    <components:InputFieldView Title="PLAYER NAME *" Placeholder="Enter player full name" Text="{Binding PlayerName}"
                                               Icon="user_circle.svg" IconSize="22"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="2" Margin="10,5,10,0" Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderStrokeLight}" StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowOverlay20Brush}" Opacity="0.12" Radius="8" Offset="0,2"/>
                </Border.Shadow>
                <VerticalStackLayout Padding="14">
                    <components:AvatarColorSelectorView Initials="BP" ItemsSource="{Binding AvatarColors}" SelectionChanged="AvatarColorChanged"/>
                    <components:InputFieldView Margin="0,30,0,0" Title="INITIALS (AUTO)" Placeholder="AB" Text="{Binding PlayerInitials}"
                                               Icon="text.svg" IconSize="22"/>
                    <Label Margin="10,0,0,0" Text="Automatically generated from player name" HorizontalOptions="Start" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                    <components:InputFieldView Margin="0,18,0,0" Title="GAMES PLAYED" Placeholder="0" Text="{Binding GamesPlayed}"
                                               Icon="trophy_1.svg" IconSize="22" />
                    <Label Margin="10,0,0,0" Text="This will be updated automatically as you play" HorizontalOptions="Start" FontSize="11" TextColor="{StaticResource SecondaryText}"/>
                </VerticalStackLayout>
            </Border>
            <!-- Scrollable Content -->
            <ScrollView Grid.Row="3">
                <VerticalStackLayout Padding="20,18,20,28" Spacing="5">
                    <components:PrimaryButtonView Text="Create Player" Icon="save.svg" 
                                                  ButtonBackground="{StaticResource PrimaryGreen}" 
                                                  ButtonTextColor="{StaticResource WhiteText}" Clicked="CreatePlayerClicked"/>

                    <components:PrimaryButtonView Text="Cancel" Icon="close.svg" 
                                                  ButtonBackground="{StaticResource CardBackground}" 
                                                  ButtonTextColor="{StaticResource PrimaryGreen}" Clicked="CancelClicked"/>
                    <!-- Other controls go here -->
                    <Label Text="Rummy360 • Offline First • Version 1.0" HorizontalOptions="Center" FontSize="12" TextColor="{StaticResource SecondaryText}"/>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</base:BasePage>