<ContentPage
    x:Class="Rummy360.Views.NewGamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F7FA">

    <ScrollView>

        <VerticalStackLayout Spacing="20">

            <!-- Header -->
            <Border Background="#0F7A3D"
                    StrokeThickness="0">

                <VerticalStackLayout Padding="24,36,24,24">

                    <Label Text="Create New Game"
                           FontSize="13"
                           TextColor="#CFE8DA"/>

                    <Label Text="Game Setup"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"/>

                </VerticalStackLayout>

            </Border>

            <!-- Game Type -->
            <Border Margin="20,0"
                    Background="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="14">

                    <Label Text="GAME TYPE"
                           FontSize="12"
                           TextColor="#6B7280"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <Border Background="#0F7A3D"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="0,12">

                            <Label Text="101"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="White"/>

                        </Border>

                        <Border Grid.Column="1"
                                Background="#F5F7FA"
                                Stroke="#D1D5DB"
                                StrokeShape="RoundRectangle 12"
                                Padding="0,12">

                            <Label Text="201"
                                   HorizontalOptions="Center"
                                   FontSize="16"
                                   TextColor="#374151"/>

                        </Border>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Drop Points -->
            <Border Margin="20,0"
                    Background="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="12">

                    <Label Text="DROP AMOUNT"
                           FontSize="12"
                           TextColor="#6B7280"/>

                    <Slider Minimum="0"
                            Maximum="80"
                            Value="40"
                            MinimumTrackColor="#D4AF37"
                            MaximumTrackColor="#E5E7EB"/>

                    <Label Text="40 Points"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F7A3D"/>

                </VerticalStackLayout>

            </Border>

            <!-- Dealer -->
            <Border Margin="20,0"
                    Background="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="8">

                    <Label Text="DEALER"
                           FontSize="12"
                           TextColor="#6B7280"/>

                    <Label Text="Bhanu Prakash ▼"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#0F7A3D"/>

                </VerticalStackLayout>

            </Border>

            <!-- Players -->
            <Border Margin="20,0"
                    Background="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="8">

                    <Label Text="PLAYERS"
                           FontSize="12"
                           TextColor="#6B7280"/>

                    <Label Text="4 Selected Players"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>

                </VerticalStackLayout>

            </Border>

            <!-- Start Button -->
            <Border Margin="20,0"
                    Background="#0F7A3D"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="StartGame_Tapped"/>
                </Border.GestureRecognizers>
                
                <Grid HeightRequest="56">

                    <Label Text="START GAME →"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="White"/>

                </Grid>

            </Border>

            <!-- Rules -->
            <Border Margin="20,0,20,24"
                    Background="#ECFDF5"
                    Stroke="#BBF7D0"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="6">

                    <Label Text="Game Rules"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#166534"/>

                    <Label Text="• First player reaching the limit is eliminated."
                           FontSize="12"
                           TextColor="#166534"/>

                    <Label Text="• Last remaining player wins the game."
                           FontSize="12"
                           TextColor="#166534"/>

                    <Label Text="• Dealer rotates every round."
                           FontSize="12"
                           TextColor="#166534"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>