<ContentPage
    x:Class="Rummy360.Views.NewGamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackgroundAlt}">

    <ScrollView>

        <VerticalStackLayout Spacing="20">

            <!-- Header -->
            <Border Background="{StaticResource PrimaryGreen}"
                    StrokeThickness="0">

                <VerticalStackLayout Padding="24,36,24,24">

                    <Label Text="Create New Game"
                           FontSize="13"
                           TextColor="{StaticResource PrimaryGreenSoftText}"/>

                    <Label Text="Game Setup"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"/>

                </VerticalStackLayout>

            </Border>

            <!-- Game Type -->
            <Border Margin="20,0"
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="14">

                    <Label Text="GAME TYPE"
                           FontSize="12"
                           TextColor="{StaticResource SecondaryText}"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <Border Background="{StaticResource PrimaryGreen}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="0,12">

                                    <Label Text="101"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{StaticResource White}"/>

                        </Border>

                        <Border Grid.Column="1"
                                Background="{StaticResource PageBackgroundAlt}"
                                Stroke="{StaticResource BorderGray}"
                                StrokeShape="RoundRectangle 12"
                                Padding="0,12">

                            <Label Text="201"
                                   HorizontalOptions="Center"
                                   FontSize="16"
                                   TextColor="{StaticResource Gray700}"/>

                        </Border>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Drop Points -->
            <Border Margin="20,0"
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="12">

                    <Label Text="DROP AMOUNT"
                           FontSize="12"
                           TextColor="{StaticResource SecondaryText}"/>

                    <Slider Minimum="0"
                            Maximum="80"
                            Value="40"
                            MinimumTrackColor="{StaticResource GoldDark}"
                            MaximumTrackColor="{StaticResource BorderStrokeLight}"/>

                    <Label Text="40 Points"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreen}"/>

                </VerticalStackLayout>

            </Border>

            <!-- Dealer -->
            <Border Margin="20,0"
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="8">

                    <Label Text="DEALER"
                           FontSize="12"
                           TextColor="{StaticResource SecondaryText}"/>

                    <Label Text="Bhanu Prakash ▼"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreen}"/>

                </VerticalStackLayout>

            </Border>

            <!-- Players -->
            <Border Margin="20,0"
                    Background="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderStrokeLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="8">

                    <Label Text="PLAYERS"
                           FontSize="12"
                           TextColor="{StaticResource SecondaryText}"/>

                    <Label Text="4 Selected Players"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryText}"/>

                </VerticalStackLayout>

            </Border>

            <!-- Start Button -->
            <Border Margin="20,0"
                    Background="{StaticResource PrimaryGreen}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="StartGame_Tapped"/>
                </Border.GestureRecognizers>
                
                <Grid HeightRequest="56">

                    <Label Text="START GAME →"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="{StaticResource White}"/>

                </Grid>

            </Border>

            <!-- Rules -->
            <Border Margin="20,0,20,24"
                    Background="{StaticResource SuccessBackground}"
                    Stroke="{StaticResource SuccessBorderLight}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="18" Spacing="6">

                    <Label Text="Game Rules"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                    <Label Text="• First player reaching the limit is eliminated."
                           FontSize="12"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                    <Label Text="• Last remaining player wins the game."
                           FontSize="12"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                    <Label Text="• Dealer rotates every round."
                           FontSize="12"
                           TextColor="{StaticResource PrimaryGreenDark}"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>