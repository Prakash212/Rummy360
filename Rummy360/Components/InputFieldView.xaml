<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Rummy360.Components.InputFieldView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    InputTransparent="False">

    <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Title, Source={x:Reference Root}}"
               FontSize="12"
               FontAttributes="Bold"
               CharacterSpacing="1.3"
               TextColor="{StaticResource SecondaryText}"/>

        <Border Background="{StaticResource CardBackground}" Stroke="{StaticResource BorderGray}" StrokeShape="RoundRectangle 12" Padding="10,0,1,1" InputTransparent="False">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="2">
                
                <Image Source="{Binding Icon, Source={x:Reference Root}}" WidthRequest="{Binding IconSize, Source={x:Reference Root}}" 
                       HeightRequest="{Binding IconSize, Source={x:Reference Root}}" VerticalOptions="Center" HorizontalOptions="Center"/>
                
                <Entry x:Name="InputEntry" Grid.Column="1" Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                       Placeholder="{Binding Placeholder, Source={x:Reference Root}}" FontSize="15" BackgroundColor="Transparent"
                       TextColor="{StaticResource PrimaryText}" PlaceholderColor="{StaticResource PlaceholderText}"
                       ClearButtonVisibility="WhileEditing" HorizontalOptions="Fill" VerticalOptions="Center" InputTransparent="False"/>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>