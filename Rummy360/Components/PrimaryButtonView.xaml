<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Rummy360.Components.PrimaryButtonView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border Background="{Binding ButtonBackground, Source={x:Reference Root}}" StrokeShape="RoundRectangle 18">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="ButtonTapped"/>
        </Border.GestureRecognizers>
        <Grid Padding="10">
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <Image Source="{Binding Icon, Source={x:Reference Root}}" WidthRequest="18" HeightRequest="18"/>
                <Label Text="{Binding Text, Source={x:Reference Root}}" FontSize="15" FontAttributes="Bold" TextColor="{Binding ButtonTextColor, Source={x:Reference Root}}"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>