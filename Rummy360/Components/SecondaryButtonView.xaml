<?xml version="1.0" encoding="utf-8"?>

<ContentView x:Class="Rummy360.Components.SecondaryButtonView" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
