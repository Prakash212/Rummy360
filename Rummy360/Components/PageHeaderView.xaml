<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Rummy360.Components.PageHeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Reusable Rummy360 Header -->
    <Border Background="{StaticResource PrimaryGreen}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,20,20">
        <Grid HeightRequest="132" Padding="24,8,24,20">
            <VerticalStackLayout VerticalOptions="End" Spacing="6" Margin="0,0,0,10">
                <Label x:Name="SubtitleLabel"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryGreenTint}"/>
                <Label x:Name="TitleLabel"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}"/>
                <Label x:Name="DescriptionLabel"
                       FontSize="14"
                       TextColor="{StaticResource PrimaryGreenSoftText}"
                       IsVisible="False"/>
                <Border Background="{StaticResource GoldAccent}"
                        WidthRequest="72"
                        HeightRequest="4"
                        StrokeThickness="0"
                        Margin="0,4,0,0"
                        VerticalOptions="Start" HorizontalOptions="Start"
                        StrokeShape="RoundRectangle 2"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>