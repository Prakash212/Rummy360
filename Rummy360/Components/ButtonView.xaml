<?xml version="1.0" encoding="utf-8"?>

<ContentView x:Class="Rummy360.Components.ButtonView" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Reusable button -->
    <Border x:Name="ButtonBorder" Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <!-- Button icon -->
            <Label x:Name="IconLabel" FontSize="20" IsVisible="False" TextColor="White" VerticalOptions="Center"/>
            <!-- Button text -->
            <Label x:Name="TextLabel" Grid.Column="1" HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
        </Grid>
    </Border>
</ContentView>