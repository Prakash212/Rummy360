<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Rummy360.Components.ActionIconView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        x:Name="CircleBorder"
        WidthRequest="{Binding ContainerSize, Source={x:Reference Root}}"
        HeightRequest="{Binding ContainerSize, Source={x:Reference Root}}"
        Background="{Binding IconBackground, Source={x:Reference Root}}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 999">

        <Image
            WidthRequest="{Binding IconSize, Source={x:Reference Root}}"
            HeightRequest="{Binding IconSize, Source={x:Reference Root}}"
            Source="{Binding Icon, Source={x:Reference Root}}"
            Aspect="AspectFit"
            Margin="0,-1,0,0"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

    </Border>

</ContentView>