<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Rummy360.Components.FloatingActionButtonView" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Name="Root">
    <Grid>
        <Border x:Name="FabBorder" WidthRequest="60" HeightRequest="60" Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 100">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="FabTapped"/>
            </Border.GestureRecognizers>
            <Grid>
                <Image
                    x:Name="FabIcon"
                    Source="plus.svg"
                    WidthRequest="28"
                    HeightRequest="28"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            </Grid>
        </Border>
        <Border x:Name="TextBorder" IsVisible="False" Margin="0,70,0,0" Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
            <Label x:Name="FabText" FontSize="12" FontAttributes="Bold" TextColor="White"/>
        </Border>
    </Grid>
</ContentView>