<?xml version="1.0" encoding="utf-8" ?>

<ContentView x:Class="Rummy360.Components.SectionTitleView" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <!-- Accent Icon -->
        <Label x:Name="IconLabel" FontSize="36" VerticalOptions="Center" Text="⚡"/>
        <!-- Title & Subtitle -->
        <VerticalStackLayout Grid.Column="1" Spacing="2">
            <Label x:Name="TitleLabel" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" Text="Quick Actions"/>
            <Label x:Name="SubtitleLabel" FontSize="11.6" TextColor="{StaticResource SecondaryText}" Text="Everything you need to manage your games."/>
        </VerticalStackLayout>
    </Grid>
</ContentView>