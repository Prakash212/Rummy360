<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Rummy360.Controls.BasePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="140,*">

        <!-- HEADER -->
        <Border Background="{StaticResource PrimaryGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,28,28">
            <VerticalStackLayout Padding="24,28,24,20" Spacing="6">
                <Label Text="{Binding HeaderCaption, Source={x:Reference Root}}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource HeaderSubtitleColor}"/>
                <Label Text="{Binding HeaderTitle, Source={x:Reference Root}}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource WhiteText}"/>
                <Label Text="{Binding HeaderSubtitle, Source={x:Reference Root}}" FontSize="14" TextColor="{StaticResource PrimaryGreenSoftText}"/>
            </VerticalStackLayout>
        </Border>

        <!-- BODY -->
        <ScrollView Grid.Row="1">
            <Grid Padding="18,-18,18,28">

                <!-- Global Watermark -->
                <Image Source="watermark_pattern.svg" Aspect="AspectFill" Opacity="0.06" InputTransparent="True"/>

                <!-- Page Content -->
                <ContentPresenter Content="{Binding BodyContent, Source={x:Reference Root}}"/>

            </Grid>
        </ScrollView>

    </Grid>

</ContentView>