<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Rummy360.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Rummy360.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False" >

    <ShellContent
        Title="Splash"
        ContentTemplate="{DataTemplate views:SplashPage}"
        Route="SplashPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <ShellContent
        Title="Players"
        Route="PlayersPage"
        ContentTemplate="{DataTemplate views:PlayersPage}" />
    <ShellContent
        Title="New Game"
        Route="NewGamePage"
        ContentTemplate="{DataTemplate views:NewGamePage}" />

    <ShellContent
        Title="Add Player"
        Route="AddPlayerPage"
        ContentTemplate="{DataTemplate views:AddPlayerPage}" />

    <ShellContent
        Title="Settings"
        Route="SettingsPage"
        ContentTemplate="{DataTemplate views:SettingsPage}" />

    <ShellContent
        Title="Live Game"
        Route="LiveScorePage"
        ContentTemplate="{DataTemplate views:LiveScorePage}" />

    <ShellContent
        Title="Round Completed"
        Route="RoundCompletedPage"
        ContentTemplate="{DataTemplate views:RoundCompletedPage}" />

    <ShellContent
        Title="Round Entry"
        Route="RoundEntryPage"
        ContentTemplate="{DataTemplate views:RoundEntryPage}" />

    <ShellContent
        Title="Round History"
        Route="RoundHistoryPage"
        ContentTemplate="{DataTemplate views:RoundHistoryPage}" />

    <ShellContent
        Title="Seating Order"
        Route="SeatingOrderPage"
        ContentTemplate="{DataTemplate views:SeatingOrderPage}" />

    <ShellContent
        Title="Select Players"
        Route="SelectPlayersPage"
        ContentTemplate="{DataTemplate views:SelectPlayersPage}" />

    <ShellContent
        Title="Statistics"
        Route="StatisticsPage"
        ContentTemplate="{DataTemplate views:StatisticsPage}" />

</Shell>
